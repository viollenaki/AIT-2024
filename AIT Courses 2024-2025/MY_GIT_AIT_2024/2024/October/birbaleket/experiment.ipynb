    "from random import randint\n",
    "from time import time\n",
    "arr = [randint(1,50) for _ in range(1000000)]\n",
    "list = []\n",
    "total = 0\n",
    "for i in arr:\n",
    "    start = time()\n",
    "    total +=1\n",
    "    end = time()\n",
    "    longt = end - start\n",
    "    list.append(longt)\n",
    "print(list)\n"
